while True:
    # Main Menu
    print("\n========== MAIN MENU ==========")
    print("1. New Game")
    print("2. Settings")  # Nová volba
    print("3. Quit")      # Posunuto na 3

    choice = input("Enter your choice (1, 2 or 3): ")

    if choice == "1":
        # Difficulty Selection Menu
        while True:
            print("\n===== CHOOSE DIFFICULTY =====")
            print("1. Easy")
            print("2. Medium")
            print("3. Hard")
            print("4. Impossible")
            print("5. Back")

            diff_choice = input("Choose difficulty (1-5): ")

            if diff_choice == "1":
                print("\nStarting game in Easy difficulty!")
                break
            elif diff_choice == "2":
                print("\nStarting game in Medium difficulty!")
                break
            elif diff_choice == "3":
                print("\nStarting game in Hard difficulty!")
                break
            elif diff_choice == "4":
                print("\nStarting game in Impossible difficulty!")
                break
            elif diff_choice == "5":
                break # Návrat do hlavního menu
            else:
                print("\nInvalid choice!")

    elif choice == "2":
        # Settings Menu
        while True:
            print("\n===== SETTINGS =====")
            print("1. Sound: ON/OFF")
            print("2. Language: EN/CZ")
            print("3. Back")

            settings_choice = input("Choose option (1-3): ")

            if settings_choice == "1":
                print("\nSound settings changed!")
            elif settings_choice == "2":
                print("\nLanguage changed!")
            elif settings_choice == "3":
                break # Návrat do hlavního menu
            else:
                print("\nInvalid choice!")

    elif choice == "3":
        print("\nExiting game... Goodbye!")
        break

    else:
        print("\nInvalid choice! Please enter 1, 2, or 3.")


class Dvere:
    def __init__(self, nazev, zamceno=False, klic=None):
        self.nazev = nazev
        self.je_otevreno = False
        self.je_zamceno = zamceno
        self.potrebny_klic = klic

    def otevrit(self, hrac_ma_klic=None):
        if self.je_otevreno:
            print(f"[{self.nazev}] Dveře už jsou otevřené.")
            return

        if self.je_zamceno:
            if hrac_ma_klic == self.potrebny_klic:
                print(f"[{self.nazev}] Odemkl jsi dveře pomocí: {hrac_ma_klic}.")
                self.je_zamceno = False
            else:
                print(f"[{self.nazev}] Dveře jsou zamčené! Potřebuješ: {self.potrebny_klic}.")
                return

        self.je_otevreno = True
        print(f"[{self.nazev}] Vrz... Dveře se otevřely.")

    def zavrit(self):
        if not self.je_otevreno:
            print(f"[{self.nazev}] Dveře už jsou zavřené.")
        else:
            self.je_otevreno = False
            print(f"[{self.nazev}] Prásk! Zavřel jsi dveře.")

# --- TESTOVÁNÍ HRY ---

# 1. Vytvoříme dvoje různé dveře
vchodove_dvere = Dvere("Vchod", zamceno=True, klic="Zlatý klíč")
dvere_do_kuchyne = Dvere("Kuchyně")

# 2. Zkusíme otevřít zamčené dveře bez klíče
vchodove_dvere.otevrit() 

# 3. Otevřeme obyčejné dveře
dvere_do_kuchyne.otevrit()

# 4. Otevřeme zamčené dveře se správným klíčem
vchodove_dvere.otevrit("Zlatý klíč")

# 5. Zavřeme dveře
vchodove_dvere.zavrit()
